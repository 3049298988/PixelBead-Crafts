{"repeatCount":-1,"pauseOnFail":false,"count":5,"minVerCode":2021000,"minVerName":"2.21.0","screenWidth":1440,"screenHeight":3168,"screenDpi":4,"lastSaveScreenWidth":3168,"lastSaveScreenHeight":1440,"lastSaveScreenDpi":4,"savedVerCode":26000050,"savedVerName":"26.5.0","description":"","delay":""}
{"type":"设置变量","delay":"0","delayUnit":1,"scriptCallbacks":{"afterExecFail":{"type":"控制执行","delayUnit":1,"controlRunType":"jumpTo","jumpToPosition":"-0","ContinueParentExecute":false}},"vars":[{"name":"board_area","value":{"varType":"screen_area","varScope":"script","showInput":true,"showInputLabel":"画板范围","mustInput":true,"rememberInputValue":true,"showInputContentAlign":"left","screenArea":"28.4% 16.8% 63.4% 94.6%"}},{"name":"palette_area","value":{"varType":"screen_area","varScope":"script","showInput":true,"showInputLabel":"色板范围","mustInput":true,"rememberInputValue":true,"showInputContentAlign":"left","screenArea":"70.1% 35.3% 87.3% 92.5%"}},{"name":"palette_colors","value":{"varType":"string","varScope":"script","showInputInObjectSubVar":false,"mustInput":false,"rememberInputValue":true,"showInputContentAlign":"left","value":""}},{"name":"board_rows","value":{"varType":"string","varScope":"script","showInput":true,"showInputLabel":"画板行","mustInput":false,"rememberInputValue":true,"textLineBefore":"默认24","showInputWidthBasis":"auto","showInputContentAlign":"right","value":""}},{"name":"board_cols","value":{"varType":"string","varScope":"script","showInput":true,"showInputLabel":"画板列","mustInput":false,"rememberInputValue":true,"textLineBefore":"默认24","showInputWidthBasis":"auto","showInputContentAlign":"right","value":""}},{"name":"palette_cols","value":{"varType":"string","varScope":"script","showInput":true,"showInputLabel":"色板一行总列数","mustInput":false,"rememberInputValue":true,"textLineBefore":"默认4","showInputWidthBasis":"auto","showInputContentAlign":"right","value":""}},{"name":"palette_total_count","value":{"varType":"string","varScope":"script","showInput":true,"showInputLabel":"色板总颜色数","mustInput":false,"rememberInputValue":true,"textLineBefore":"默认40","showInputWidthBasis":"auto","showInputContentAlign":"right","value":""}},{"name":"palette_visible_rows","value":{"varType":"string","varScope":"script","showInput":true,"showInputLabel":"色板一页行数","mustInput":false,"rememberInputValue":true,"textLineBefore":"默认6","showInputWidthBasis":"auto","showInputContentAlign":"right","value":""}},{"name":"board_click_delay","value":{"varType":"string","varScope":"script","showInput":true,"showInputLabel":"画板点击间隔（ms）","mustInput":false,"rememberInputValue":true,"textLineBefore":"默认40","showInputWidthBasis":"auto","showInputContentAlign":"right","value":""}},{"name":"palette_click_delay","value":{"varType":"string","varScope":"script","showInput":true,"showInputLabel":"色板点击间隔（ms）","mustInput":false,"rememberInputValue":true,"textLineBefore":"默认40","showInputWidthBasis":"auto","showInputContentAlign":"left","value":""}},{"name":"board_click_duration","value":{"varType":"string","varScope":"script","showInput":true,"showInputLabel":"点击持续时间（ms）","mustInput":false,"rememberInputValue":true,"textLineBefore":"默认20","showInputWidthBasis":"auto","showInputContentAlign":"left","value":""}},{"name":"start_delay","value":{"varType":"string","varScope":"script","showInput":true,"showInputLabel":"开始前等待时间（ms）","mustInput":false,"rememberInputValue":true,"textLineBefore":"默认3000","showInputWidthBasis":"auto","showInputContentAlign":"left","value":""}},{"name":"target_package","value":{"varType":"array_string","varScope":"script","showInput":true,"showInputLabel":"允许运行的包名","mustInput":false,"rememberInputValue":true,"textLineBefore":"默认添加官服","showInputContentAlign":"left","array":[]}}],"dialogShowOnce":true,"dialogCancelText":"停止","dialogCancelAction":{"type":"控制执行","delayUnit":1,"controlRunType":"stop","jumpToPosition":"","ContinueParentExecute":false}}
{"type":"运行JS代码","delay":"0","delayUnit":1,"scriptCallbacks":{"afterConditionFail":{"type":"打开链接","delayUnit":1,"link":"https:\/\/3049298988.github.io\/PixelBead-Crafts\/"}},"jsCode":"\/**\n * 自动精灵：动态参数适配、色彩匹配与用量排序作画脚本\n * 更新：整合可视化文件读取（动态临时\/持久化过滤）、自定义包名自动去重追加、错误退出联动\n * 修改：取消输入方式菜单及文件选择均可层级回退至上级菜单\n *\/\n(function main() {\n    zdjl.toast(\"脚本启动中...\");\n\n    \/\/ ================= 1. 配置与初始化模块 =================\n    const rawBoardVar = zdjl.getVar(\"board_area\");\n    const rawPaletteVar = zdjl.getVar(\"palette_area\");\n\n    function parseArea(varData) {\n        if (!varData) return null;\n        if (typeof varData === 'object') {\n            if ('left' in varData && 'top' in varData) {\n                return {\n                    left: Number(varData.left),\n                    top: Number(varData.top),\n                    right: Number(varData.right || varData.left),\n                    bottom: Number(varData.bottom || varData.top)\n                };\n            }\n            if (Array.isArray(varData) && Array.isArray(varData[0])) {\n                return {\n                    left: Math.min(varData[0][0], varData[1][0]),\n                    top: Math.min(varData[0][1], varData[1][0]),\n                    right: Math.max(varData[0][0], varData[1][0]),\n                    bottom: Math.max(varData[0][1], varData[1][1])\n                };\n            }\n        }\n        return null;\n    }\n\n    const boardRect = parseArea(rawBoardVar);\n    const paletteRect = parseArea(rawPaletteVar);\n\n    if (!boardRect || !paletteRect) {\n        zdjl.toast(\"错误：请先设置 board_area 和 palette_area 变量！\");\n        return;\n    }\n\n    function getInt(varName, defaultVal) {\n        const val = zdjl.getVar(varName);\n        if (val === null || val === undefined || val === '') return defaultVal;\n        const parsed = parseInt(val, 10);\n        return isNaN(parsed) ? defaultVal : parsed;\n    }\n\n    const config = {\n        board: boardRect,\n        palette: paletteRect,\n        boardCols: getInt(\"board_cols\", 24),\n        boardRows: getInt(\"board_rows\", 24),\n        cols: getInt(\"palette_cols\", 4),\n        paletteTotalCount: getInt(\"palette_total_count\", 40),\n        visibleRows: getInt(\"palette_visible_rows\", 6),\n        delayBoard: getInt(\"board_click_delay\", 40),\n        delayPalette: getInt(\"palette_click_delay\", 40),\n        delayStart: getInt(\"start_delay\", 3000),\n        boardClickDuration: getInt(\"board_click_duration\", 20),\n        targetPackages: []\n    };\n\n    \/\/ 包名数组化处理：优先自定义包名，后追加官服与 B 服默认包名并去重\n    const defaultPkgs = [\"com.hypergryph.arknights\", \"com.hypergryph.arknights.bilibili\"];\n    const userPkg = zdjl.getVar(\"target_package\");\n    const rawList = userPkg ? [userPkg, ...defaultPkgs] : defaultPkgs;\n\n    config.targetPackages = Array.from(new Set(rawList.filter(Boolean)));\n\n    console.log(`[Debug] 用户自定义包名: ${userPkg || \"未设置\"}`);\n    console.log(`[Debug] 默认追加包名: ${defaultPkgs.join(\", \")}`);\n    console.log(`[Debug] 最终生效包名列表: ${config.targetPackages.join(\", \")}`);\n\n    config.totalRows = Math.ceil(config.paletteTotalCount \/ config.cols);\n    const needsPagination = config.totalRows > config.visibleRows;\n    const bottomViewportStartRow = needsPagination ? (config.totalRows - config.visibleRows) : 0;\n    const cellW = (config.palette.right - config.palette.left) \/ config.cols;\n    const cellH = (config.palette.bottom - config.palette.top) \/ config.visibleRows;\n    const midX = Math.floor(config.palette.left + (config.palette.right - config.palette.left) \/ 2);\n\n    let currentViewState = -1;\n\n    \/\/ ================= 2. 包名校验模块 =================\n    function verifyTargetApp() {\n        try {\n            const node = zdjl.findNode({ type: 'node' });\n            if (node) {\n                const rawPkg = node.packageName || node.pkg || node.package;\n                if (rawPkg) {\n                    const currentPkg = String(rawPkg).trim();\n                    console.log(`[Debug] 捕获当前包名: \"${currentPkg}\"`);\n\n                    const isMatched = config.targetPackages.some(pkg => String(pkg).trim() === currentPkg);\n\n                    if (!isMatched) {\n                        zdjl.toast(`错误：当前应用包名 [${currentPkg}] 不在目标列表中`);\n                        return false;\n                    }\n                }\n            }\n        } catch (e) {\n            console.warn(\"应用包名检测异常: \" + e.message);\n        }\n        return true;\n    }\n\n    \/\/ ================= 3. UI 交互与文件选择模块 =================\n    function showModeSelection() {\n        if (typeof zdjl.select === \"function\") {\n            const selectRes = zdjl.select({\n                title: \"请选择运行模式\",\n                items: [\n                    \"1. 正常作画 (选择数据输入方式)\",\n                    \"2. 循环测试 (色号循环填充测试)\",\n                    \"3. Debug 提取 (采集 HEX 写入剪贴板)\",\n                    \"4. 访问配套数据网站 (错误结束并跳转)\"\n                ]\n            });\n            return (selectRes && selectRes.result !== undefined) ? selectRes.result : -1;\n        }\n        return 0;\n    }\n\n    function showInputMenu() {\n        if (typeof zdjl.select === \"function\") {\n            const res = zdjl.select({\n                title: \"选择数据输入方式\",\n                items: [\n                    \"1. 粘贴 JSON 或 色号文本\",\n                    \"2. 可视化选择文件\"\n                ]\n            });\n            return res ? res.result : -1;\n        }\n        return 0;\n    }\n\n    function promptDataInput(hintStr, defaultVal = \"\") {\n        let inputResult = null;\n        try {\n            if (typeof zdjl.prompt === \"function\") {\n                inputResult = zdjl.prompt(hintStr, defaultVal);\n            } else if (typeof prompt === \"function\") {\n                inputResult = prompt(hintStr, defaultVal);\n            }\n        } catch (e) {}\n        return inputResult;\n    }\n\n    function pickLocalFile(startDir) {\n        let fs;\n        try {\n            fs = require('fs');\n        } catch (e) {\n            zdjl.toast(\"环境不支持沙盒 FS 读取\");\n            return null;\n        }\n\n        \/\/ 读取持久化文件过滤设置（多个后缀逗号分隔），默认以 .json, .js 过滤\n        const storedExts = zdjl.getVar(\"file_filter_exts\");\n        let activeExts = storedExts ? String(storedExts).split(',').map(s => s.trim().toLowerCase()).filter(Boolean) : ['.json', '.js'];\n\n        let currentDir = startDir || \"\/sdcard\/Download\";\n        if (!fs.existsSync(currentDir)) {\n            currentDir = \"\/sdcard\";\n        }\n\n        while (true) {\n            let entries = [];\n            try {\n                entries = fs.readdirSync(currentDir);\n            } catch (e) {\n                zdjl.toast(\"无法读取目录，已重置至根目录\");\n                currentDir = \"\/sdcard\";\n                continue;\n            }\n\n            const dirs = [];\n            const files = [];\n\n            entries.forEach(name => {\n                if (name.startsWith('.')) return;\n                const fullPath = (currentDir.endsWith('\/') ? currentDir : currentDir + '\/') + name;\n                try {\n                    const stat = fs.statSync(fullPath);\n                    if (stat.isDirectory()) {\n                        dirs.push(name);\n                    } else {\n                        const lowerName = name.toLowerCase();\n                        if (activeExts.includes('*') || activeExts.some(ext => lowerName.endsWith(ext))) {\n                            files.push(name);\n                        }\n                    }\n                } catch (e) {}\n            });\n\n            dirs.sort();\n            files.sort();\n\n            const items = [];\n            if (currentDir !== \"\/\" && currentDir !== \"\/sdcard\") {\n                items.push(\"返回上级目录 [..]\");\n            }\n            \n            const filterLabel = activeExts.includes('*') ? \"全部(*)\" : activeExts.join(',');\n            items.push(`⚙️ 设置文件过滤类型 (当前: ${filterLabel})`);\n\n            dirs.forEach(d => items.push(\"[文件夹] \" + d));\n            files.forEach(f => items.push(\"[文件] \" + f));\n\n            const selectRes = zdjl.select({\n                title: \"路径: \" + currentDir,\n                items: items\n            });\n\n            if (!selectRes || selectRes.result === undefined || selectRes.result === -1) {\n                return null;\n            }\n\n            const chosenText = items[selectRes.result];\n\n            if (chosenText === \"返回上级目录 [..]\") {\n                const parts = currentDir.replace(\/\\\/$\/, '').split('\/');\n                parts.pop();\n                currentDir = parts.join('\/') || '\/';\n            } else if (chosenText.startsWith(\"⚙️ 设置文件过滤类型\")) {\n                const optRes = zdjl.select({\n                    title: \"选择修改方式\",\n                    items: [\n                        \"1. 临时修改 (仅本次运行生效)\",\n                        \"2. 默认设置 (持久化保存配置)\"\n                    ]\n                });\n\n                if (optRes && optRes.result !== undefined && optRes.result !== -1) {\n                    const currentExtStr = activeExts.join(',');\n                    const inputStr = promptDataInput(\"输入文件扩展名 (用逗号分隔，输入 * 显示全部)\", currentExtStr);\n\n                    if (inputStr !== null && inputStr.trim() !== \"\") {\n                        const newExts = inputStr.split(',')\n                            .map(s => s.trim().toLowerCase())\n                            .map(s => (s.startsWith('.') || s === '*') ? s : '.' + s)\n                            .filter(Boolean);\n\n                        if (newExts.length > 0) {\n                            activeExts = newExts;\n                            if (optRes.result === 1) {\n                                zdjl.setVar(\"file_filter_exts\", activeExts.join(','));\n                                zdjl.toast(\"已持久化更新文件过滤规则\");\n                            } else {\n                                zdjl.toast(\"已临时修改文件过滤规则\");\n                            }\n                        }\n                    }\n                }\n            } else if (chosenText.startsWith(\"[文件夹] \")) {\n                const dirName = chosenText.replace(\"[文件夹] \", \"\");\n                currentDir = (currentDir.endsWith('\/') ? currentDir : currentDir + '\/') + dirName;\n            } else if (chosenText.startsWith(\"[文件] \")) {\n                const fileName = chosenText.replace(\"[文件] \", \"\");\n                const filePath = (currentDir.endsWith('\/') ? currentDir : currentDir + '\/') + fileName;\n                try {\n                    return fs.readFileSync(filePath, 'utf-8');\n                } catch (e) {\n                    zdjl.toast(\"读取文件失败：\" + e.message);\n                }\n            }\n        }\n    }\n\n    \/\/ ================= 4. 数据解析与处理模块 =================\n    function generateLoopTestMatrix() {\n        zdjl.toast(`执行：${config.paletteTotalCount} 色号循环测试`);\n        const matrix = Array.from({ length: config.boardRows }, () => Array(config.boardCols).fill(0));\n        let idx = 0;\n        for (let r = 0; r < config.boardRows; r++) {\n            for (let c = 0; c < config.boardCols; c++) {\n                matrix[r][c] = idx % config.paletteTotalCount;\n                idx++;\n            }\n        }\n        return matrix;\n    }\n\n    function tryParseJSON(jsonData) {\n        const matrix = Array.from({ length: config.boardRows }, () => Array(config.boardCols).fill(0));\n        if (jsonData.grid && Array.isArray(jsonData.grid)) {\n            const grid = jsonData.grid;\n            for (let r = 0; r < config.boardRows; r++) {\n                for (let c = 0; c < config.boardCols; c++) {\n                    const idx = r * config.boardCols + c;\n                    if (idx < grid.length) {\n                        const val = parseInt(grid[idx], 10);\n                        matrix[r][c] = (!isNaN(val) && val >= 1 && val <= config.paletteTotalCount) ? (val - 1) : 0;\n                    }\n                }\n            }\n            return matrix;\n        }\n\n        let cells = Array.isArray(jsonData) ? jsonData : (jsonData.cells || []);\n        if (cells.length > 0) {\n            for (let i = 0; i < cells.length; i++) {\n                const cell = cells[i];\n                if (cell.x >= 0 && cell.x < config.boardCols && cell.y >= 0 && cell.y < config.boardRows) {\n                    let pIndex = 0;\n                    if (cell.palPos) {\n                        const m = cell.palPos.match(\/第(\\d+)行第(\\d+)列\/);\n                        if (m) pIndex = (parseInt(m[1], 10) - 1) * config.cols + (parseInt(m[2], 10) - 1);\n                    } else if (typeof cell.seq === 'number') {\n                        pIndex = (cell.seq - 1) % config.paletteTotalCount;\n                    }\n                    matrix[cell.y][cell.x] = Math.max(0, Math.min(config.paletteTotalCount - 1, pIndex));\n                }\n            }\n            return matrix;\n        }\n        return null;\n    }\n\n    function parseTokensToMatrix(tokens) {\n        const matrix = Array.from({ length: config.boardRows }, () => Array(config.boardCols).fill(0));\n        let tokenIdx = 0;\n        for (let r = 0; r < config.boardRows; r++) {\n            for (let c = 0; c < config.boardCols; c++) {\n                const token = tokens[tokenIdx++];\n                let val = parseInt(token, 10);\n                if (token && (token.startsWith('#') || \/^[0-9A-Fa-f]{6}$\/.test(token))) {\n                    val = 1; \n                }\n                matrix[r][c] = (!isNaN(val) && val >= 1 && val <= config.paletteTotalCount) ? (val - 1) : 0;\n            }\n        }\n        return matrix;\n    }\n\n    function processInputData(dataContent) {\n        const requiredCount = config.boardCols * config.boardRows;\n        \n        if (dataContent.startsWith(\"{\") || dataContent.startsWith(\"[\")) {\n            try {\n                const parsedJSON = JSON.parse(dataContent);\n                const jsonMatrix = tryParseJSON(parsedJSON);\n                if (jsonMatrix) {\n                    zdjl.toast(\"成功解析 JSON 数据\");\n                    return jsonMatrix;\n                }\n            } catch (e) {\n                console.warn(\"JSON 解析异常，转为文本分隔模式\");\n            }\n        }\n\n        let tokens = dataContent.split(\/[\\s\\n\\r,;|]+\/).filter(Boolean);\n\n        if (tokens.length !== requiredCount) {\n            const msg = tokens.length < requiredCount \n                ? `数据不足 (当前 ${tokens.length}，需要 ${requiredCount})` \n                : `数据超出 (当前 ${tokens.length}，需要 ${requiredCount})`;\n\n            let confirmRes = null;\n            if (typeof zdjl.select === \"function\") {\n                confirmRes = zdjl.select({\n                    title: msg + \"\\n请选择下一步操作\",\n                    items: [\n                        \"1. 继续 (不足填充白色 \/ 超出自动截断)\",\n                        \"2. 返回重新编辑\"\n                    ]\n                });\n            }\n\n            if (confirmRes && confirmRes.result === 1) {\n                return null;\n            }\n\n            if (tokens.length < requiredCount) {\n                while(tokens.length < requiredCount) tokens.push(\"1\");\n            } else {\n                tokens = tokens.slice(0, requiredCount);\n            }\n        }\n\n        zdjl.toast(\"成功解析文本数据\");\n        return parseTokensToMatrix(tokens);\n    }\n\n    \/\/ ================= 5. 画板触控与状态模块 =================\n    function ensureViewState(targetState) {\n        if (!needsPagination) {\n            currentViewState = 0;\n            return;\n        }\n        if (currentViewState === targetState) return;\n\n        if (targetState === 0) {\n            zdjl.swipe(midX, config.palette.top + 20, midX, config.palette.bottom - 20, 400);\n            zdjl.sleep(600);\n            currentViewState = 0;\n        } else if (targetState === 1) {\n            zdjl.swipe(midX, config.palette.bottom - 20, midX, config.palette.top + 20, 400);\n            zdjl.sleep(600);\n            currentViewState = 1;\n        }\n    }\n\n    function selectPaletteColorByIndex(targetIndex) {\n        const targetRow = Math.floor(targetIndex \/ config.cols);\n        const targetCol = targetIndex % config.cols;\n        let requiredState = currentViewState;\n\n        if (needsPagination) {\n            if (targetRow < bottomViewportStartRow) requiredState = 0;\n            else if (targetRow >= config.visibleRows) requiredState = 1;\n            else if (currentViewState === -1) requiredState = 0;\n        } else {\n            requiredState = 0;\n        }\n\n        ensureViewState(requiredState);\n        const rowInViewport = (currentViewState === 0) ? targetRow : (targetRow - bottomViewportStartRow);\n        const cx = Math.floor(config.palette.left + targetCol * cellW + cellW \/ 2);\n        const cy = Math.floor(config.palette.top + rowInViewport * cellH + cellH \/ 2);\n\n        zdjl.click(cx, cy, 20);\n        zdjl.sleep(config.delayPalette);\n    }\n\n    function executeDebugExtractColors() {\n        zdjl.toast(\"Debug：开始扫描提取色板颜色...\");\n        zdjl.sleep(800);\n\n        const colorList = [];\n        const firstPartCount = config.visibleRows * config.cols;\n\n        ensureViewState(0);\n        for (let i = 0; i < firstPartCount && i < config.paletteTotalCount; i++) {\n            const r = Math.floor(i \/ config.cols);\n            const c = i % config.cols;\n            const cx = Math.floor(config.palette.left + c * cellW + cellW \/ 2);\n            const cy = Math.floor(config.palette.top + r * cellH + cellH \/ 2);\n            const rawColor = zdjl.getScreenColor(cx, cy);\n            const hexColor = \"#\" + ((Number(rawColor) || 0) & 0xFFFFFF).toString(16).padStart(6, '0').toUpperCase();\n            colorList.push({ index: i + 1, row: r + 1, col: c + 1, hex: hexColor, raw: rawColor });\n        }\n\n        if (needsPagination) {\n            ensureViewState(1);\n            for (let i = firstPartCount; i < config.paletteTotalCount; i++) {\n                const r = Math.floor(i \/ config.cols);\n                const c = i % config.cols;\n                const rowInViewport = r - bottomViewportStartRow;\n                const cx = Math.floor(config.palette.left + c * cellW + cellW \/ 2);\n                const cy = Math.floor(config.palette.top + rowInViewport * cellH + cellH \/ 2);\n                const rawColor = zdjl.getScreenColor(cx, cy);\n                const hexColor = \"#\" + ((Number(rawColor) || 0) & 0xFFFFFF).toString(16).padStart(6, '0').toUpperCase();\n                colorList.push({ index: i + 1, row: r + 1, col: c + 1, hex: hexColor, raw: rawColor });\n            }\n        }\n\n        const exportJson = JSON.stringify(colorList, null, 2);\n        zdjl.setClipboard(exportJson);\n        zdjl.toast(\"已成功将 HEX 数据复制到剪贴板！\", 3000);\n    }\n\n    \/\/ ================= 6. 主控制流程 =================\n    try {\n        let drawMatrix = null;\n\n        while (!drawMatrix) {\n            const selectedMode = showModeSelection();\n\n            if (selectedMode === -1) {\n                zdjl.toast(\"已取消运行\");\n                return;\n            }\n\n            if (selectedMode === 3) {\n                zdjl.toast(\"正在跳转配套数据网站...\");\n                try {\n                    zdjl.runAction({\n                        \"type\": \"打开链接\",\n                        \"delayUnit\": 1,\n                        \"link\": \"https:\/\/3049298988.github.io\/PixelBead-Crafts\/\"\n                    });\n                } catch (e) {}\n                throw new Error(\"ERROR_EXIT_TRIGGER_WEB\");\n            }\n\n            if (!verifyTargetApp()) {\n                return;\n            }\n\n            if (selectedMode === 0) {\n                while (!drawMatrix) {\n                    const inputType = showInputMenu();\n                    if (inputType === -1) {\n                        \/\/ 取消选择数据输入方式：打破当前循环，回退到 modeSelection 菜单\n                        break; \n                    }\n\n                    let dataContent = \"\";\n                    if (inputType === 0) {\n                        dataContent = promptDataInput(\"请输入 JSON 数据或色号文本\");\n                        if (dataContent === null || dataContent === undefined) {\n                            continue; \/\/ 取消文本输入，回退至 inputMenu 菜单\n                        }\n                    } else if (inputType === 1) {\n                        dataContent = pickLocalFile(\"\/sdcard\/Download\");\n                        if (dataContent === null || dataContent === undefined) {\n                            continue; \/\/ 取消文件选择，回退至 inputMenu 菜单\n                        }\n                    }\n\n                    const trimmedInput = dataContent.trim();\n                    if (!trimmedInput) {\n                        zdjl.toast(\"输入内容为空，请重新操作\");\n                        continue;\n                    }\n\n                    drawMatrix = processInputData(trimmedInput);\n                }\n            } else if (selectedMode === 1) {\n                drawMatrix = generateLoopTestMatrix();\n            } else if (selectedMode === 2) {\n                executeDebugExtractColors();\n                return;\n            }\n        }\n\n        if (!drawMatrix) {\n            zdjl.toast(\"未生成有效作画数据，已退出\");\n            return;\n        }\n\n        zdjl.toast(\"请将悬浮窗等移至画板\/色板范围外\");\n        zdjl.sleep(1000);\n        zdjl.toast(\"正在分析颜色用量与分页状态...\");\n        \n        const colorFrequency = {};\n        for (let i = 0; i < config.paletteTotalCount; i++) colorFrequency[i] = [];\n\n        for (let r = 0; r < config.boardRows; r++) {\n            for (let c = 0; c < config.boardCols; c++) {\n                colorFrequency[drawMatrix[r][c]].push({ r: r, c: c });\n            }\n        }\n\n        let maxCount = -1;\n        let maxColorIndex = 0;\n        for (let i = 0; i < config.paletteTotalCount; i++) {\n            if (colorFrequency[i].length > maxCount) {\n                maxCount = colorFrequency[i].length;\n                maxColorIndex = i;\n            }\n        }\n\n        const maxColorRow = Math.floor(maxColorIndex \/ config.cols);\n        let primaryState = 0;\n        if (needsPagination) {\n            if (maxColorRow >= config.visibleRows) primaryState = 1;\n            else if (maxColorRow < bottomViewportStartRow) primaryState = 0; \n            else primaryState = 0;\n        }\n\n        let groupA = []; \n        let groupB = []; \n\n        for (let i = 0; i < config.paletteTotalCount; i++) {\n            if (colorFrequency[i].length > 0) {\n                const item = { colorIndex: i, cells: colorFrequency[i] };\n                const row = Math.floor(i \/ config.cols);\n\n                if (!needsPagination) {\n                    groupA.push(item);\n                } else if (primaryState === 0) {\n                    if (row < config.visibleRows) groupA.push(item);\n                    else groupB.push(item);\n                } else {\n                    if (row >= bottomViewportStartRow) groupA.push(item);\n                    else groupB.push(item);\n                }\n            }\n        }\n\n        groupA.sort((a, b) => b.cells.length - a.cells.length);\n        groupB.sort((a, b) => b.cells.length - a.cells.length);\n\n        zdjl.toast(\"初始化色板位置...\");\n        ensureViewState(primaryState);\n\n        zdjl.toast(`将在 ${config.delayStart\/1000} 秒后开始作画...`);\n        zdjl.sleep(config.delayStart);\n        \n        const boardCellW = (config.board.right - config.board.left) \/ config.boardCols;\n        const boardCellH = (config.board.bottom - config.board.top) \/ config.boardRows;\n\n        const drawGroup = (group) => {\n            for (let i = 0; i < group.length; i++) {\n                const item = group[i];\n                selectPaletteColorByIndex(item.colorIndex);\n                for (let j = 0; j < item.cells.length; j++) {\n                    const cell = item.cells[j];\n                    const bx = Math.floor(config.board.left + cell.c * boardCellW + boardCellW \/ 2);\n                    const by = Math.floor(config.board.top + cell.r * boardCellH + boardCellH \/ 2);\n                    zdjl.click(bx, by, config.boardClickDuration);\n                    zdjl.sleep(config.delayBoard);\n                }\n            }\n        };\n\n        if (groupA.length > 0) drawGroup(groupA);\n        if (groupB.length > 0) drawGroup(groupB);\n\n        zdjl.toast(\"作画完成！\");\n    } catch (err) {\n        if (err && err.message === \"ERROR_EXIT_TRIGGER_WEB\") {\n            throw err;\n        }\n        zdjl.toast(\"运行已平滑结束: \" + err.message);\n    }\n})();\n"}
